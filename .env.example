# Copy to .env and fill in. .env is git-ignored.
# Only EXPO_PUBLIC_* values are bundled into the app. They are public by design;
# the data is protected by Supabase Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Deployed Vercel URL (no trailing slash). Leave empty for the web build on Vercel itself.
EXPO_PUBLIC_API_BASE_URL=https://your-vercel-app.vercel.app

# Server-only — set these in Vercel project environment variables, NEVER in the app.
# GEMINI_API_KEY=
# GEMINI_MODEL=            (optional; defaults to gemini-flash-latest)
# SUPABASE_SERVICE_ROLE_KEY=
